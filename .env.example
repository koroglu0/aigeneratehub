# Shared variables (all services)
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=your-32-char-minimum-secret-here-12345
SERVICE_JWT_SECRET=your-service-jwt-secret-here
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
DYNAMODB_ENDPOINT=http://localhost:8000

# Prompt Builder specific
PORT=3001

# AI Integration specific
# PORT=3002
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=standard
PROMPT_BUILDER_URL=http://prompt-builder:3001

# User Service specific
# PORT=3003
BCRYPT_ROUNDS=12

# API Gateway
API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.eu-north-1.amazonaws.com
AI_INTEGRATION_URL=http://ai-integration:3002
USER_SERVICE_URL=http://user-service:3003
