{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "paths": {
      "@api/*":        ["./src/api/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*":      ["./src/hooks/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@screens/*":    ["./src/screens/*"],
      "@store/*":      ["./src/store/*"],
      "@types/*":      ["./src/types/*"],
      "@utils/*":      ["./src/utils/*"]
    }
  }
}
