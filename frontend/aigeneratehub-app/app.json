{
  "expo": {
    "name": "AI Generate Hub",
    "slug": "aigeneratehub-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aigeneratehub.app"
    },
    "android": {
      "package": "com.aigeneratehub.app",
      "usesCleartextTraffic": true,
      "permissions": ["android.permission.READ_MEDIA_IMAGES", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow AI Generate Hub to access your photos.",
          "savePhotosPermission": "Allow AI Generate Hub to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
